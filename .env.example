# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# The API key for the frontier LLM (Path B fallback)
# Get one from: https://aistudio.google.com/apikey (free, no credit card)
GEMINI_API_KEY=your-gemini-api-key-here

# The base URL for the frontier LLM (Path B)
# Using Gemini's OpenAI-compatible endpoint (free tier: 15 RPM, 1M tokens/day)
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# The model to use for Path B (the expensive fallback)
UPSTREAM_MODEL=gemini-2.0-flash

# Confidence threshold — decisions above this skip the LLM (Path A)
CONFIDENCE_THRESHOLD=0.70

# Context budget — requests with more tokens than this skip Tier 0
CONTEXT_BUDGET_TOKENS=450

# Server settings
HOST=127.0.0.1
PORT=8080
